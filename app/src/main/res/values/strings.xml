    <!-- Guide Dialogs Detail -->
    <string name="guide_1st_aid_title">Guía de 1eros A</string>
    <string name="guide_1st_aid_info">Protocolo de Actuación:\n1. Evaluación primaria (ABCDE).\n2. Asegurar vía aérea y control de columna cervical.\n3. Evaluación de ventilación y circulación.\n4. Identificación de déficit neurológico.\n*Priorice el soporte vital básico ante colapso.*</string>

    <string name="guide_vital_signs_title">Signos Vitales</string>
    <string name="guide_vital_signs_info">Valores de referencia (Adulto):\n• Presión Arterial: 120/80 mmHg (Normal).\n• Frecuencia Cardíaca: 60-100 lpm.\n• Frecuencia Respiratoria: 12-20 rpm.\n• Temperatura: 36.5°C - 37.5°C.\n• SatO2: >95% aire ambiente.</string>

    <string name="guide_emergency_triage_title">Triaje - Priorización</string>
    <string name="guide_emergency_triage_info">Clasificación de Emergencia:\n• Rojo: Reanimación inmediata.\n• Naranja: Muy urgente (10 min).\n• Amarillo: Urgente (60 min).\n• Verde: Menos urgente.\n• Azul: No urgente (atención diferida).</string>

    <string name="guide_prevention_title">Protocolos Prevención</string>
    <string name="guide_prevention_info">Normas de Bioseguridad:\n1. Higiene de manos (técnica OMS).\n2. Uso estricto de EPP (guantes, mascarilla, mandil).\n3. Clasificación de residuos (Bolsa roja para biocontaminados).\n4. Desinfección de superficies tras cada paciente.</string>

    <string name="guide_meds_safety_title">Seguridad Farmacológica</string>
    <string name="guide_meds_safety_info">Regla de los 5 Correctos:\n1. Paciente correcto.\n2. Medicamento correcto.\n3. Dosis correcta.\n4. Vía de administración correcta.\n5. Hora correcta.\n*Verificar siempre alergias previas en historia clínica.*</string>

    <string name="guide_contacts_title">Directorio Interno</string>
    <string name="guide_contacts_info">Unidades de Emergencia:\n• Médico de Guardia: #501\n• Enfermería Triaje: #502\n• Laboratorio Clínico: #505\n• Banco de Sangre: #508\n• Admisión/Seguridad: #500</string>
