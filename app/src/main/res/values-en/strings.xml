    <!-- Guide Dialogs Detail -->
    <string name="guide_1st_aid_title">1st Aid Guide</string>
    <string name="guide_1st_aid_info">Action Protocol:\n1. Primary assessment (ABCDE).\n2. Secure airway and cervical spine control.\n3. Assess ventilation and circulation.\n4. Neurological deficit identification.\n*Prioritize basic life support in case of collapse.*</string>

    <string name="guide_vital_signs_title">Vital Signs</string>
    <string name="guide_vital_signs_info">Reference values (Adult):\n• Blood Pressure: 120/80 mmHg (Normal).\n• Heart Rate: 60-100 bpm.\n• Respiratory Rate: 12-20 rpm.\n• Temperature: 36.5°C - 37.5°C.\n• SatO2: >95% room air.</string>

    <string name="guide_emergency_triage_title">Triage - Prioritization</string>
    <string name="guide_emergency_triage_info">Emergency Classification:\n• Red: Immediate resuscitation.\n• Orange: Very urgent (10 min).\n• Yellow: Urgent (60 min).\n• Green: Less urgent.\n• Blue: Non-urgent (delayed care).</string>

    <string name="guide_prevention_title">Prevention Protocols</string>
    <string name="guide_prevention_info">Biosafety Standards:\n1. Hand hygiene (WHO technique).\n2. Strict use of PPE (gloves, mask, gown).\n3. Waste classification (Red bag for biocontaminated).\n4. Surface disinfection after each patient.</string>

    <string name="guide_meds_safety_title">Pharmacological Safety</string>
    <string name="guide_meds_safety_info">Rule of the 5 Rights:\n1. Right patient.\n2. Right medication.\n3. Right dose.\n4. Right route.\n5. Right time.\n*Always check previous allergies in medical history.*</string>

    <string name="guide_contacts_title">Internal Directory</string>
    <string name="guide_contacts_info">Emergency Units:\n• On-call Doctor: #501\n• Triage Nursing: #502\n• Clinical Laboratory: #505\n• Banco de Sangre: #508\n• Admission/Security: #500</string>
