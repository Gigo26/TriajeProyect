<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ColorPrimary"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">

        <ImageView
            android:id="@+id/ivAnalisisImagenRegresar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_regresar"
            tools:ignore="ContentDescription,MissingConstraints" />

        <!-- Título de la pantalla -->
        <TextView
            android:id="@+id/tvTituloAnalisis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Análisis de la Lesión"
            android:textSize="26sp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Subtítulo explicativo -->
        <TextView
            android:id="@+id/tvSubtituloAnalisis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tome una foto clara de la zona afectada para que nuestro modelo de IA ayude a predecir la gravedad del golpe o herida."
            android:textSize="15sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvTituloAnalisis"
            tools:ignore="HardcodedText" />

        <!-- Contenedor / Vista previa de la Imagen -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvVistaPrevia"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtituloAnalisis"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F0F4F8">

                <!-- Imagen por defecto antes de tomar la foto -->
                <ImageView
                    android:id="@+id/ivFotoLesion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_camera"
                    android:padding="60dp"
                    app:tint="#A6B4C0"
                    tools:ignore="ContentDescription" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Principal: Tomar Foto -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTomarFoto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="Tomar Foto de Lesión"
            android:textSize="16sp"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_camera"
            app:backgroundTint="#1565D8"
            app:cornerRadius="28dp"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintTop_toBottomOf="@id/cvVistaPrevia"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Botón Secundario: Subir de Galería -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubirGaleria"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Seleccionar de Galería"
            android:textSize="16sp"
            app:icon="@android:drawable/ic_menu_gallery"
            app:strokeColor="#1565D8"
            app:strokeWidth="2dp"
            android:textColor="#1565D8"
            app:cornerRadius="28dp"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintTop_toBottomOf="@id/btnTomarFoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Botón Textual: Omitir paso (Hace que la IA sea OPCIONAL) -->
        <TextView
            android:id="@+id/tvOmitirPaso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:layout_gravity="center"
            android:text="Omitir este paso"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1565D8"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>