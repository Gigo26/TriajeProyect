<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ColorPrimary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">

            <ImageView
                android:id="@+id/ivAnalisisImagenRegresar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_regresar"
                tools:ignore="ContentDescription,MissingConstraints" />

            <!-- Título de la pantalla -->
            <TextView
                android:id="@+id/tvEvaluacionInicial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/primary_evaluation"
                android:textSize="26sp"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/black"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="HardcodedText" />

            <!-- Subtítulo explicativo -->
            <TextView
                android:id="@+id/tvSubtituloAnalisis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/basic_questions_desc"
                android:textSize="15sp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/tvTituloAnalisis"
                tools:ignore="HardcodedText" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp">
                    <TextView
                        android:id="@+id/tvQuestion1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/is_conscious"
                        android:textColor="@android:color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"
                        tools:ignore="HardcodedText" />
                    <RadioGroup
                        android:id="@+id/rgOptions1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbOptionYes1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/yes"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"
                            android:layout_marginBottom="8dp"
                            app:buttonTint="@color/design_default_color_primary"
                            tools:ignore="HardcodedText,RtlSymmetry" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbOptionNo1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/no"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"
                            app:buttonTint="@color/design_default_color_primary"
                            tools:ignore="HardcodedText,RtlSymmetry" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Pregunta -->
                    <TextView
                        android:id="@+id/tvQuestion2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/breathes_normally"
                        android:textColor="@android:color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"
                        tools:ignore="HardcodedText" />

                    <!-- Grupo de Opciones (Selección única) -->
                    <RadioGroup
                        android:id="@+id/rgOptions2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Alternativa Sí -->
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbOptionYes2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/yes"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"
                            android:layout_marginBottom="8dp"
                            app:buttonTint="@color/design_default_color_primary"
                            tools:ignore="HardcodedText,RtlSymmetry" />

                        <!-- Alternativa No -->
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbOptionNo2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/no"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"
                            app:buttonTint="@color/design_default_color_primary"
                            tools:ignore="HardcodedText,RtlSymmetry" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <!-- Pregunta -->
                    <TextView
                        android:id="@+id/tvQuestion3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/has_bleeding"
                        android:textColor="@android:color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"
                        tools:ignore="HardcodedText" />
                    <!-- Grupo de Opciones (Selección única) -->
                    <RadioGroup
                        android:id="@+id/rgOptions3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <!-- Alternativa Sí -->
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbOptionYes3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/yes"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"
                            android:layout_marginBottom="8dp"
                            app:buttonTint="@color/design_default_color_primary"
                            tools:ignore="HardcodedText,RtlSymmetry" />

                        <!-- Alternativa No -->
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbOptionNo3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/no"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"
                            app:buttonTint="@color/design_default_color_primary"
                            tools:ignore="HardcodedText,RtlSymmetry" />

                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Botón Principal: Tomar Foto -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEvaluar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="@string/next"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#1565D8"
                app:cornerRadius="28dp"
                app:layout_constraintWidth_max="320dp"
                app:layout_constraintTop_toBottomOf="@id/cvVistaPrevia"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>